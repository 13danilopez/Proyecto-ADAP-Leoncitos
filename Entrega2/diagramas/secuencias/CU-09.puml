@startuml
title CU-09 -- Consulta historial de modificaciones

actor "Personal autorizado(Admin/SuperAdmin)"
participant "LeoncitosManager"
participant "LogActividad"

"Personal autorizado(Admin/SuperAdmin)" -> "LeoncitosManager" : consultarHistorialModificaciones()
"LeoncitosManager" -> "LogActividad" : getLog()
"LogActividad" --> "LeoncitosManager" : listaLogs
"LeoncitosManager" --> "Personal autorizado(Admin/SuperAdmin)" : mostrarLogsCronologicos()

opt Filtrado del historial [Filtrar por usuario y fechas]
    "Personal autorizado(Admin/SuperAdmin)" -> "LeoncitosManager" : filtrarLogs(usuario, rangoFechas)
    "LeoncitosManager" --> "Personal autorizado(Admin/SuperAdmin)" : mostrarLogsFiltrados()
end

"LeoncitosManager" -> "LogActividad" : registrarAccion()

@enduml