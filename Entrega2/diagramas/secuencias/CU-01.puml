@startuml
title CU-01 — Autenticación de usuario

actor "Actor"
participant "LeoncitosManager"
participant "Usuario"
participant "LogActividad"

"Actor" -> "LeoncitosManager" : solicitarInicioSesion()
"LeoncitosManager" --> "Actor" : mostrarCampos(email, contraseña)
"Actor" -> "LeoncitosManager" : iniciarSesion(email, contraseña)
"LeoncitosManager" -> "Usuario" : autenticar()
"Usuario" --> "LeoncitosManager" : True
"LeoncitosManager" -> "LogActividad" : registrarAccion()
"LeoncitosManager" --> "Actor" : concederAcceso()
"Usuario" --> "LeoncitosManager" : False
"LeoncitosManager" -> "LogActividad" : registrarAccion()
"LeoncitosManager" --> "Actor" : mostrarError("Usuario o contraseña incorrectos")

@enduml